{
  "name": "library-module",
  "version": "1.0.0",
  "description": "Offline-first Library Management System for J & D Institute of Nursing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
